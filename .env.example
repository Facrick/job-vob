# Скопируйте этот файл в .env и заполните своими ключами
# cp .env.example .env

# --- AI-провайдер (выберите один) ---

# OpenRouter — работает в России без VPN, регистрация: https://openrouter.ai/
# Поддерживает те же модели Llama/Mistral. Если задан — Groq игнорируется.
OPENROUTER_API_KEY=

# Groq — быстрый, бесплатный, но заблокирован в РФ без прокси: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Прокси для hh.ru и Groq (оставьте пустым, если не нужен)
# Пример: socks5://user:pass@host:port  или  http://host:port
PROXY_URL=

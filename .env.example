# Скопируйте этот файл в .env и заполните своими ключами
# cp .env.example .env

# Ключ от Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Ключ от Groq: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Прокси для hh.ru (оставьте пустым, если не нужен)
PROXY_URL=
